{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "lint-staged": {
    "packages/**/src/**/*.{js,ts,tsx}": [
      "node_modules/.bin/eslint --quiet --ext js,ts,tsx"
    ],
    "packages/**/src/**/*.{js,jsx,ts,tsx,css,scss,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && npm run lint:ts",
      "commit-msg": "commitlint -e $GIT_PARAMS"
    }
  },
  "config": {
    "commitizen": {
      "path": "cz-lerna-changelog"
    }
  },
  "scripts": {
    "start": "pnpm run docs",
    "build:gears": "cd packages/gears && pnpm run build",
    "build:antd": "cd packages/gears-antd && pnpm run build",
    "build": "pnpm run build:gears && pnpm run line && pnpm run build:antd",
    "docs": "NODE_OPTIONS=--openssl-legacy-provider dumi dev",
    "docs:build": "NODE_OPTIONS=--openssl-legacy-provider dumi build",
    "lint:es": "node_modules/.bin/eslint packages/**/src --quiet --ext ts,tsx,js,jsx",
    "lint:ts": "turbo run lint:ts",
    "lint": "turbo run lint:es && pnpm run lint:ts",
    "prettier": "prettier --write ./packages/**/src/**/*.{js,jsx,ts,tsx,json,css,scss,md}",
    "line": "echo \" ----------- \"",
    "preinstall": "node scripts/only-allow pnpm",
    "clean": "turbo run clean",
    "commit": "git-cz",
    "update": "lerna version --conventional-commits --no-push",
    "update:beta": "lerna version --conventional-prerelease --no-push --no-changelog",
    "update:manual": "lerna version --no-push",
    "publish:all": "turbo run publish",
    "postpublish": "git push origin HEAD --follow-tags",
    "prerelease": "pnpm run build && pnpm run lint",
    "release": "FORCE_COLOR=1 pnpm run prerelease && pnpm run update && pnpm run publish:all && pnpm run postpublish"
  },
  "devDependencies": {
    "@babel/cli": "7.17.10",
    "@babel/core": "7.18.5",
    "@babel/plugin-transform-runtime": "7.18.5",
    "@babel/preset-env": "7.18.2",
    "@babel/preset-react": "7.17.12",
    "@babel/preset-typescript": "7.17.12",
    "@babel/runtime": "7.17.8",
    "@commitlint/cli": "^12.1.4",
    "@commitlint/config-conventional": "^12.1.4",
    "@commitlint/config-lerna-scopes": "^12.1.4",
    "@rollup/plugin-babel": "5.3.1",
    "@rollup/plugin-commonjs": "22.0.0",
    "@rollup/plugin-node-resolve": "13.3.0",
    "@trivago/prettier-plugin-sort-imports": "^2.0.2",
    "@types/classnames": "2.2.9",
    "@types/history": "^4.7.5",
    "@types/lodash": "^4.14.182",
    "@types/react": "17.0.1",
    "@types/react-dom": "17.0.1",
    "@umijs/plugin-sass": "^1.1.1",
    "@tinks/xeno": "^1.0.0",
    "antd": "^5.26.5",
    "axios": "0.26.0",
    "babel-plugin-import": "1.13.5",
    "chalk": "^4.1.2",
    "classnames": "2.2.6",
    "commitizen": "^4.2.3",
    "cross-env": "5.2.0",
    "cross-spawn": "^7.0.3",
    "cz-lerna-changelog": "^2.0.3",
    "dayjs": "^1.10.4",
    "dumi": "1.1.50",
    "eslint": "7.13.0",
    "eslint-config-react-ts-sonar": "^1.8.1",
    "husky": "4.3.0",
    "lerna": "^4.0.0",
    "less": "4.1.2",
    "lint-staged": "10.5.4",
    "postcss": "^8.3.6",
    "prettier": "2.2.1",
    "qrcode.react": "^3.0.1",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "rimraf": "^3.0.2",
    "rollup": "^2.75.5",
    "rollup-plugin-postcss": "4.0.2",
    "sass": "1.38.0",
    "sass-loader": "^12.4.0",
    "semver": "^7.3.5",
    "turbo": "^1.3.4",
    "typescript": "4.9.3",
    "use-atom-view": "1.1.0"
  },
  "resolutions": {
    "@types/react": "17.0.1",
    "prettier": "2.2.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
