{
  "version": "1.1.0",
  "packages": [
    "packages/*"
  ],
  "npmClient": "yarn",
  "useWorkspaces": true,
  "command": {
    "version": {
      "allowBranch": "master",
      "includeMergedTags": true,
      "conventionalCommits": true
    },
    "publish": {
      "ignoreChanges": [
        "docs/**",
        "dist_docs/**",
        "scripts/**",
        ".dumi/**",
        ".umirc.ts",
        "**/tsconfig.json",
        "**/README.md"
      ],
      "message": "chore: publish",
      "registry": "https://registry.npmjs.org/"
    }
  },
  "changelog": {
    "labels": {
      "pr(enhancement)": ":rocket: Enhancement",
      "pr(bug)": ":bug: Bug Fix",
      "pr(documentation)": ":book: Documentation",
      "pr(dependency)": ":deciduous_tree: Dependency",
      "pr(chore)": ":turtle: Chore"
    },
    "repo": "TinkGu/gears",
    "cacheDir": ".changelog"
  }
}
